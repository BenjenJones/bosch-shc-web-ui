{
  "name": "bosch-shc-ui",
  "version": "0.1.4",
  "description": "Lokale Web-UI für den Bosch Smart Home Controller (SHC)",
  "main": "server.js",
  "scripts": {
    "setup": "node setup.js",
    "setup:auth": "node setup.js --auth-only",
    "prestart": "npm run build:css",
    "start": "node server.js",
    "predemo": "npm run build:css",
    "demo": "node demo.js",
    "demo:build": "node demo/build-dataset.js",
    "build:css": "tailwindcss -i public/tailwind.src.css -o public/tailwind.css --minify",
    "watch:css": "tailwindcss -i public/tailwind.src.css -o public/tailwind.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:build": "node test/scripts/merge-openapi.mjs",
    "mock:serve": "prism mock test/openapi/_bundled.yml -p 4010 --errors",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "express": "5.2.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.15.10",
    "js-yaml": "^4.2.0",
    "playwright-core": "^1.64.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.0",
    "vitest": "4.1.11"
  }
}
